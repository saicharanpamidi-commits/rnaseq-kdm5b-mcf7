// =============================================================================
// nextflow.config — RNA-seq Pipeline
// HPC: SLURM + Apptainer + HPC modules
// =============================================================================

process {

    executor     = 'slurm'
    queue        = 'general'
    clusterOptions = '--account=r00270'

    // ── Default resources ────────────────────────────────────────────────────
    cpus   = 4
    memory = '16 GB'
    time   = '12h'

    // ── Error handling ───────────────────────────────────────────────────────
    errorStrategy = 'retry'
    maxRetries    = 1

    // ── Process-specific overrides ───────────────────────────────────────────

    withName: FASTQC {
        cpus   = 4
        memory = '8 GB'
        time   = '2h'
    }

    withName: FASTP {
        cpus   = 4
        memory = '8 GB'
        time   = '4h'
    }

    withName: STAR_ALIGN {
        cpus     = 8
        memory   = '64 GB'
        time     = '24h'
        maxForks = 3
    }

    withName: INDEX_BAM {
        cpus   = 2
        memory = '8 GB'
        time   = '2h'
    }

    withName: INFER_STRANDEDNESS {
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }

    withName: READ_DISTRIBUTION {
        cpus   = 2
        memory = '8 GB'
        time   = '2h'
    }

    withName: PARSE_STRANDEDNESS {
        cpus   = 1
        memory = '2 GB'
        time   = '15m'
    }

    withName: FEATURECOUNTS {
        cpus   = 8
        memory = '16 GB'
        time   = '4h'
    }

    withName: MULTIQC {
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }
}


// ── Apptainer (container runtime) ────────────────────────────────────────────
apptainer {
    enabled    = true
    autoMounts = true
}


// ── Environment (HPC-safe) ───────────────────────────────────────────────────
env {
    PATH = "/N/soft/rhel8/apptainer/1.3.6/bin:$PATH"
}


// ── Pipeline parameters ───────────────────────────────────────────────────────
params {
    // Input data
    reads        = "data/fastq/*_{1,2}.fastq.gz"

    // Reference files
    genome_index = "${projectDir}/reference/star_index"
    gtf          = "${projectDir}/reference/gencode.v44.annotation.gtf"
    bed          = "${projectDir}/reference/gencode.v44.bed"  // Required by RSeQC

    // Conda environment for RSeQC (installed via pip)
    rseqc_env    = "rseqc_env"
}
